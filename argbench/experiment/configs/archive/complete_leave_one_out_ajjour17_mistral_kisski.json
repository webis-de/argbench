{
    "is_eval": false,
    "is_hpo": false,
    "seed": 42,
    "base_model": "/bigwork/nhwpajjy/pre-trained-models/Mistral-7B-Instruct-v0.2",
    "cutoff_len": 2000,
    "data_folder": "/bigwork/nhwpajjy/task-specific-argument-mining-and-generation-data/tasks",
    "data_type": "ndjson",
    "run_output_path": "/bigwork/nhwpajjy/task-specific-argument-mining-and-generation-data/runs/multiple-datasets",
    "leaderboard_path": "/bigwork/nhwpajjy/task-specific-argument-mining-and-generation-data/runs/tasks-sample-results.csv",
    "task_metrics_path": "/bigwork/nhwpajjy/task-specific-argument-mining-and-generation/argbench/experiment/configs/config_task_metrics_sample.json",
    "generation_config_path": "/bigwork/nhwpajjy/task-specific-argument-mining-and-generation/argbench/experiment/configs/config_alpaca_vllm_generation.json",

    "train_datasets": {
        "subsample_amount": 50,
        "prompt_template": "### Instruction:\n{definition}\n### Input: {instance_input}\n### Response:",
        "exclude_datasets": [
            "counter_argument_generation_candela_hua19",
            "counter_argument_generation_cmv_hua18",
            "argument_unit_segmentation_entity_ajjour17"
        ],
        "include_task": [
            "argument_unit_classification_essays_stab17"
        ]
    },
    "test_datasets": {
        "subsample_amount": 10,
        "prompt_template": "### Instruction:\n{definition}\n### Input: {instance_input}\n### Response:",
        "tasks": [
            "argument_unit_segmentation_ajjour17"
        ],

        "match": "argument_unit_segmentation"
    },
    "quant_config": {
        "load_in_4bit": true
    },
    "model_config": {
        "device_map": "cuda:0"
    },
    "peft_configs": [
        {
            "model_id": "/bigwork/nhwpajjy/pre-trained-models/alpaca-lora-7b/",
            "adapter_name": "adapter",
            "is_trainable": true,
            "adapter_type": "LORA",
            "config": {
                "base_model_name_or_path": "/bigwork/nhwpajjy/pre-trained-models/baffo32/decapoda-research-llama-7B-hf",
                "bias": "none",
                "fan_in_fan_out": false,
                "inference_mode": true,
                "lora_alpha": 16,
                "lora_dropout": 0.05,
                "modules_to_save": null,
                "peft_type": "LORA",
                "r": 16,
                "target_modules": [
                    "q_proj",
                    "k_proj",
                    "v_proj",
                    "o_proj"
                ],
                "task_type": "CAUSAL_LM"
            }
        }
    ],
    "training_args_config": {
        "per_device_train_batch_size": 32,
        "num_train_epochs": 1,
        "learning_rate": 0.0003,
        "optim": "adamw_bnb_8bit",
        "evaluation_strategy": "steps",
        "save_strategy": "steps",
        "eval_steps": 1000,
        "save_steps": 1000,


        "load_best_model_at_end": true,
        "group_by_length": false,
        "do_eval": true,

        "warmup_steps": 200,
        "fp16": true,
        "logging_steps": 10,
        "lr_scheduler_type": "linear",
        "metric_for_best_model": "loss",
        "output_dir": "/bigwork/nhwpajjy/task-specific-argument-mining-and-generation-data/fine-tuned-models/unit-classification"
    },
    "early_stopping_config": {
        "early_stopping_patience": 3,
        "early_stopping_threshold": 0.01
    },
    "data_collator_config": {
	"padding": true,
        "return_tensors": "pt"
    },
    "generation_config": {
        "max_length": 1500,
	    "max_new_tokens": 1000
    },
    "validation_config": {
        "batch_size": 2,
        "eval_metric": "bio-fscore"
    },
    "vllm_config": {
        "temperature": 0.2,
        "top_p": 1,
        "top_k": 1,
        "max_tokens": 2000
    }

}
