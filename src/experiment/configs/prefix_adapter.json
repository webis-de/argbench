{
    "seed": 42,
    "base_model": "/bigwork/nhwpbozd/decapoda-research-llama-7B-hf/",
    "cutoff_len": 1500,
    "train_dataasets": {
        "stab18_stance_classification": {
            "match": "stab18_stance_classification",
            "prompt_template": "### Instruction:\n{definition}\n### Input:\nPositive Example:\nInput: {positive_example_input_0}\nOutput: {positive_example_output_0}\nNegative Example:\nInput: {negative_example_input_0}\nOutput: {negative_example_output_0}\nInput: {instance_input}\n### Response:",
            "subsample_amount": 200
        }
    },
    "test_datasets": {
        "barhaim21_key_point": {
            "match": "barhaim21_key_point",
            "prompt_template": "### Instruction:\n{definition}\n### Input:\nPositive Example:\nInput: {positive_example_input_0}\nOutput: {positive_example_output_0}\nNegative Example:\nInput: {negative_example_input_0}\nOutput: {negative_example_output_0}\nInput: {instance_input}\n### Response:",
            "subsample_amount": 200
        }
    },
    "llama_causal_config": {
        "device_map": "auto"
    },
    "peft_fresh_config": {
        "adapter_type": "prefix-tuning",
        "adapter_name": "prefix-adapter",
        "config_args": {
            "peft_type": "PREFIX_TUNING",
            "num_virtual_tokens": 20,
            "token_dim": 768,
            "encoder_hidden_size": 768,
            "num_layers": 12,
            "task_type": "CAUSAL_LM"
        }
    },
    "quant_config": {
        "load_in_4bit": true
    },
    "training_args_config": {
        "per_device_train_batch_size": 32,
        "num_train_epochs": 110,
        "learning_rate": 0.0003,
        "optim": "adamw_torch",
        "evaluation_strategy": "steps",
        "save_strategy": "steps",
        "eval_steps": 5,
        "save_steps": 5,
        "save_total_limit": 3,
        "load_best_model_at_end": true,
        "group_by_length": false,
        "do_eval": true,
        "output_dir": "/bigwork/nhwpbozd/train-checkpoint",
        "save_total_limit": 3,
        "warmup_steps": 100,
        "fp16": true,
        "logging_steps": 10,
        "lr_scheduler_type": "linear",
        "metric_for_best_model": "loss"
    },
    "early_stopping_config": {
        "early_stopping_patience": 3,
        "early_stopping_threshold": 0.01
    },
    "data_collator_config": {
        "padding": true,
        "return_tensors": "pt"
    },
    "generation_config": {
        "top_k": 20,
        "length_penalty": 1.5,
        "num_beams": 1,
        "max_length": 250
    },
    "validation_config": {
        "eval_metric": "f1",
        "f1_average": "macro"
    }
}
