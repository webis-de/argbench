{
    "seed": 42,
    "base_model": "baffo32/decapoda-research-llama-7B-hf",
    "cutoff_len": 1100,
    "data_folder": "/home/dima/Projects/data/",
    "train_datasets": {
        "leave_one_out": true,
        "subsample_amount": 50,
        "prompt_template": "### Instruction:\n{definition}\n### Input: {instance_input}\n### Response:",
        "exclude_datasets": [
            "counter_argument_generation_candela_hua19",
            "counter_argument_generation_cmv_hua18"
        ]
    },
    "test_datasets": {
        "prompt_template": "### Instruction:\n{definition}\n### Input: {instance_input}\n### Response:"
    },
    "quant_config": {
        "load_in_4bit": true
    },
    "llama_causal_config": {
        "device_map": "cuda:0"
    },
    "peft_configs": [
        {
            "model_id": "tloen/alpaca-lora-7b",
            "adapter_name": "adapter",
            "is_trainable": true
        }
    ],
    "training_args_config": {
        "per_device_train_batch_size": 2,
        "num_train_epochs": 15,
        "learning_rate": 0.0003,
        "optim": "adamw_bnb_8bit",
        "evaluation_strategy": "steps",
        "save_strategy": "steps",
        "eval_steps": 1,
        "save_steps": 1,
        "save_total_limit": 20,
        "load_best_model_at_end": true,
        "group_by_length": false,
        "do_eval": true,
        "save_total_limit": 20,
        "warmup_steps": 200,
        "fp16": false,
        "logging_steps": 10,
        "lr_scheduler_type": "linear",
        "metric_for_best_model": "loss"
    },
    "early_stopping_config": {
        "early_stopping_patience": 3,
        "early_stopping_threshold": 0.01
    },
    "data_collator_config": {
        "padding": true,
        "return_tensors": "pt",
        "max_length": 1100
    },
    "generation_config": {
        "top_k": 20,
        "length_penalty": 1.5,
        "num_beams": 1,
        "max_length": 1500
    },
    "validation_config": {
        "batch_size": 2
    }
}
